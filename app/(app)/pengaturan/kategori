import { getCategories, saveCategories } from "@/lib/storage";
import { auth } from "@/auth";
import { redirect } from "next/navigation";
import { revalidatePath } from "next/cache";
import Link from "next/link";
import CategoryManager from "@/components/CategoryManager";

export default async function KategoriPage() {
  const session = await auth();
  if (!session?.user?.id) redirect("/login");
  const userId = session.user.id;

  const categories = await getCategories(userId);

  async function handleAdd(formData: FormData) {
    "use server";
    const session = await auth();
    if (!session?.user?.id) throw new Error("Unauthorized");
    const name = (formData.get("name") as string).trim();
    const type = formData.get("type") as "income" | "expense" | "both";
    if (!name) throw new Error("Nama tidak boleh kosong");

    const current = await getCategories(session.user.id);
    const newCat = { id: crypto.randomUUID(), name, type };
    await saveCategories(session.user.id, [...current, newCat]);
    revalidatePath("/pengaturan/kategori");
    revalidatePath("/transaksi");
  }

  async function handleDelete(formData: FormData) {
    "use server";
    const session = await auth();
    if (!session?.user?.id) throw new Error("Unauthorized");
    const id = formData.get("id") as string;
    const current = await getCategories(session.user.id);
    await saveCategories(session.user.id, current.filter((c) => c.id !== id));
    revalidatePath("/pengaturan/kategori");
    revalidatePath("/transaksi");
  }

  return (
    <main className="px-4 sm:px-6 lg:px-8 py-5 space-y-5 max-w-2xl mx-auto lg:mx-0">
      <div className="flex items-center gap-2 mb-2">
        <Link href="/pengaturan" className="text-gray-500 hover:text-gray-800 dark:hover:text-gray-300">
          ← Kembali
        </Link>
      </div>

      <div className="flex items-center gap-2">
        <span className="w-1 h-5 bg-red-600 rounded-full"></span>
        <h1 className="text-lg font-bold">Pengaturan Kategori</h1>
      </div>

      <CategoryManager
        categories={categories}
        onAdd={handleAdd}
        onDelete={handleDelete}
      />
    </main>
  );
}